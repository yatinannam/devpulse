+			fmt.Printf("  ! %-6s %-28s %3d×  %s avg  (%d errors)\n", e.Method, e.Path, e.Count, e.Average.Round(time.Millisecond), e.Errors)
+		}
+	}
+}
+func healthMarker(h string) string {
+	switch h {
+	case "healthy":
+		return "●"
+	case "warning":
+		return "●"
+	case "error":
+		return "●"
+	default:
+		return "○"
+	}
+}
